-- =========================================================================
-- LÓGICA FLING (Touch Fling - CORRIGIDO)
-- =========================================================================

local flingLoop = nil

local function startNewFlingLoop()
    -- Se o loop já existe, apenas garante que está ativo.
    if flingLoop then return end 

    flingLoop = coroutine.wrap(function()
        local c, hrp, vel, movel = nil, nil, nil, 0.1
        
        -- Loop principal do Fling adaptado do script fornecido
        while flingEnabled do
            RunService.Heartbeat:Wait()
            c = player.Character
            
            hrp = c and c:FindFirstChild("HumanoidRootPart")
    
            if hrp and hrp.Parent then
                
                -- Ancoragem Temporária para evitar o auto-fling contra o chão
                hrp.Anchored = true 
                
                vel = hrp.Velocity
                -- Primeira aplicação: Grande força para cima
                hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
            
                RunService.RenderStepped:Wait()
                
                hrp.Anchored = false -- Desancorar imediatamente para colidir com o alvo
                
                -- Segunda aplicação: Velocidade normal (cai um pouco)
                hrp.Velocity = vel
                RunService.Stepped:Wait()
                -- Terceira aplicação: Pequeno empurrão para manter no ar
               
                hrp.Velocity = vel + Vector3.new(0, movel, 0)
                movel = -movel -- Alterna o pequeno empurrão vertical
            end
        end
        
        -- Garante que esteja desancorado ao desligar
        if hrp and hrp.Parent then
            hrp.Anchored = false
        end
        
        flingLoop = nil -- Permite que seja iniciado novamente
    end)
    
    -- Inicia o loop (o wrapper coroutine o executa imediatamente)
    flingLoop()
end

-- LÓGICA DE ATIVAÇÃO
local function executeToggleFling(btnFling)
   
    
    local currentRootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not currentRootPart then 
        notify("Erro: Personagem não carregado. Tente novamente.", COLOR_OFF)
        return
    end

    flingEnabled = not flingEnabled
    
    if flingEnabled then
        
        -- CORREÇÃO: Desabilita estados que causam dano de queda/queda
        if humanoid then
            -- SetStateEnabled deve ser envolvido em pcall pois pode não ser permitido pelo servidor/game
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.FallingDown, false)
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.GettingUp, false)
        end
        
        startNewFlingLoop()
        
        btnFling.Text = "Fling (Touch): [On]"
        btnFling.BackgroundColor3 = COLOR_ON
        notify("Touch Fling Ativado (Dano de Queda Desativado)!", COLOR_ON)
    else
        
        -- CORREÇÃO: Reabilita estados
        if humanoid then
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.FallingDown, true)
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.GettingUp, true)
        end
        
        -- A coroutine é encerrada naturalmente quando flingEnabled se torna falso
        
        btnFling.Text = "Fling (Touch): [Off]"
        btnFling.BackgroundColor3 = COLOR_OFF
        notify("Touch Fling Desativado!", COLOR_OFF)
    end
    
    local targetColor = flingEnabled and COLOR_ON or COLOR_OFF
    TweenService:Create(btnFling, TWEEN_INFO, {BackgroundColor3 = targetColor}):Play()
end


