local function handleInput(input, gameProcessed)
    if UserInputService:GetFocusedTextBox() then return end
    
    if not isFlying then return end

    local control_key = key_map[input.KeyCode]
    
    if control_key and not gameProcessed then
        
        local isBegin = input.UserInputState == Enum.UserInputState.Begin
        local value = isBegin and 1 or 0
        
   
        if control_key == "F" then
         
            CONTROL.F = value
        elseif control_key == "B" then
            CONTROL.B = -value 
        elseif control_key == "L" then
          
            CONTROL.L = -value 
    
        elseif control_key == "R" then
            CONTROL.R = value
     
        elseif control_key == "Q" then
            CONTROL.Q = value
        elseif control_key == "E" then
            CONTROL.E = -value 
        end
    end
end

UserInputService.InputBegan:Connect(handleInput)
UserInputService.InputEnded:Connect(handleInput)

local function flyLoop() 
    
 
    -- Verificação de Segurança do FlyLoop
    if not isFlying or not rootPart or not bodyVelocity or not bodyGyro or not bodyVelocity.Parent or not bodyGyro.Parent then 
        return 
    end

    local camera = workspace.CurrentCamera
   
    
    
    if CONTROL.L + CONTROL.R ~= 0 or CONTROL.F + CONTROL.B ~= 0 or CONTROL.Q + CONTROL.E ~= 0 then
        SPEED = 50 
    elseif not (CONTROL.L + CONTROL.R ~= 0 or CONTROL.F + CONTROL.B ~= 0 or (CONTROL.Q + CONTROL.E) ~= 0) and SPEED ~= 0 then
        SPEED = 0
    end
    
    if (CONTROL.L + CONTROL.R) ~= 0 or (CONTROL.F + CONTROL.B) ~= 0 or (CONTROL.Q + CONTROL.E) ~= 0 then
    
     
        local direction_vector = (
            (camera.CFrame.LookVector * (CONTROL.F + CONTROL.B)) + 
 
            ((camera.CFrame * CFrame.new(CONTROL.L + CONTROL.R, 0, 0).p) - camera.CFrame.p) + 
          
            (Vector3.new(0, 1, 0) * (CONTROL.Q + CONTROL.E)) 
        )
        
 
        bodyVelocity.Velocity = direction_vector * SPEED

        lCONTROL = {F = CONTROL.F, B = CONTROL.B, L = CONTROL.L, R = CONTROL.R, Q = CONTROL.Q, E = CONTROL.E}
        
    elseif SPEED ~= 0 then
        local inertia_vector = (
         
            (camera.CFrame.LookVector * (lCONTROL.F + lCONTROL.B)) + 
       
            ((camera.CFrame * CFrame.new(lCONTROL.L + lCONTROL.R, 0, 0).p) - camera.CFrame.p) +
           
            (Vector3.new(0, 1, 0) * (lCONTROL.Q + lCONTROL.E))
        )
        
        bodyVelocity.Velocity = inertia_vector * SPEED
    else
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    end
    
 
    bodyGyro.CFrame = camera.CFrame 
end

-- Função de Ativação/Desativação do Fly (Interna)
local function executeToggleFly(btnFly)
    flyEnabled = not flyEnabled
    
    if flyEnabled then
        
        -- LIGA O FLY
        isFlying = true
        humanoid.PlatformStand = true -- Fly PRECISA de PlatformStand
        rootPart.Anchored = false
        humanoid.WalkSpeed = 0 
        humanoid.JumpPower = 0
        
     
       
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
   
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = rootPart
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.P = 9e4 
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.CFrame = rootPart.CFrame
        bodyGyro.Parent = rootPart
  
        
        current_connection = RunService.RenderStepped:Connect(flyLoop)
        
        btnFly.Text = "Fly: [On]"
        btnFly.BackgroundColor3 = COLOR_ON 
        
        notify("Fly Ativado",Color3.fromRGB(50,200,50)) 
    else
        -- DESLIGA O FLY
        isFlying = false
        
 
  
        if current_connection then
      
            current_connection:Disconnect()
            current_connection = nil
        end
        
        if bodyVelocity and bodyVelocity.Parent then bodyVelocity:Destroy() end
        if bodyGyro and bodyGyro.Parent then bodyGyro:Destroy() end
        bodyVelocity = nil
        bodyGyro = nil
 
 
        
        CONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
        lCONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
        SPEED = 0

        humanoid.PlatformStand = false 
        rootPart.Anchored = false
        
        humanoid.WalkSpeed = walkSpeed 
  
    
        humanoid.JumpPower = jumpPower 
        
        btnFly.Text = "Fly: [Off]"
        btnFly.BackgroundColor3 = COLOR_OFF 
        notify("Fly Desativado!",Color3.fromRGB(200,50,50))
    end
    
    local targetColor = flyEnabled and COLOR_ON or COLOR_OFF
    TweenService:Create(btnFly, TWEEN_INFO, {BackgroundColor3 = targetColor}):Play() 
end


