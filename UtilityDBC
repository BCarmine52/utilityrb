        executeToggleSuperRing(tempBtn) 
        tempBtn:Destroy()
    end

    if godModeEnabled then
      
    local tempBtn = Instance.new("TextButton")
        executeToggleGodMode(tempBtn) 
        tempBtn:Destroy()
    end
    
    if flingEnabled then
        local tempBtn = Instance.new("TextButton")
        executeToggleFling(tempBtn)
        tempBtn:Destroy()
    end

    -- 2. Restaura os valores padrões do Humanoid (apenas para garantir)
    if humanoid then
        humanoid.WalkSpeed = DEFAULT_WALK_SPEED
        humanoid.JumpPower = DEFAULT_JUMP_POWER
        humanoid.PlatformStand = false
        -- Garante que estados do Fling sejam reativados
        pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.FallingDown, true)
        pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.GettingUp, true)
    end
    
    if rootPart then
        rootPart.Anchored = false
    end

    -- 3. Destrói o GUI
    if screenGui then
        screenGui:Destroy()
    end
end

