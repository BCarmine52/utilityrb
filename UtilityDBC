local function createButton(text, height, parent, initialColor)
    
    local isSmall = height == SMALL_BUTTON_HEIGHT
    local buttonWidth = isSmall and 140 or 280

    local button = Instance.new("TextButton")
    
    button.Size = UDim2.new(0, buttonWidth, 0, height)
    local xPos = isSmall and 20 or 20 
    
    local yPos = currentY
    if not isSmall then
        yPos = currentY
        currentY = currentY + height + PADDING
    end
    
    button.Position = UDim2.new(0, xPos, 0, yPos)
    
    local defaultColor = initialColor or COLOR_DEFAULT_BUTTON
    
    button.BackgroundColor3 = defaultColor
    button.TextColor3 = Color3.fromRGB(255,255,255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 16
    button.Text = text
    button.AutoButtonColor = false
    button.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,10)
    corner.Parent = button
    
    if not initialColor then 
        button.MouseEnter:Connect(function() 
            TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLOR_HOVER_BUTTON}):Play() 
        end)
        
        button.MouseLeave:Connect(function() 
            TweenService:Create(button, TWEEN_INFO, {BackgroundColor3 = COLOR_DEFAULT_BUTTON}):Play() 
        end)
    end
    
    return button
end

