RunService.Stepped:Connect(function() 
    if character and rootPart and humanoid then 
        -- Lógica de Colisão (Noclip e Fly)
        local canCollide = not noclipEnabled and not flyEnabled
        
        for _, part in character:GetDescendants() do 
            if part:IsA("BasePart") then 
                part.CanCollide = canCollide 
            end 
        end 
         
        -- Lógica de Plataforma (Apenas Fly)
        if flyEnabled then
            humanoid.PlatformStand = true
            humanoid.WalkSpeed = 0 
            humanoid.JumpPower = 0
        else
            humanoid.PlatformStand = false
            -- Restaura as stats salvas se o Fly estiver OFF
            humanoid.WalkSpeed = walkSpeed 
            humanoid.JumpPower = jumpPower 
        end
        
        -- Garante que o Fling não desative acidentalmente o PlatformStand se o Fly estiver ativo
        if flyEnabled then
            humanoid.PlatformStand = true 
        end
    end
end)
