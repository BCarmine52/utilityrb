local function startDrag(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
        input.UserInputType == Enum.UserInputType.Touch then 
        isDragging = true 
        dragStartPos = input.Position 
        frameStartPos = frame.Position 
        frame.ZIndex = 2 
        shadow.ZIndex = 1 
    end 
end 
local function doDrag(input) 
    if isDragging then 
        local delta = input.Position - dragStartPos 
        local newX = frameStartPos.X.Offset + delta.X 
        local newY = frameStartPos.Y.Offset + delta.Y 
        local newPosition = UDim2.new(frameStartPos.X.Scale, newX, frameStartPos.Y.Scale, newY) 
        frame.Position = newPosition 
        local shadowNewX = newX - 2 
        local shadowNewY = newY - 2 
        shadow.Position = UDim2.new(frameStartPos.X.Scale, shadowNewX, frameStartPos.Y.Scale, shadowNewY) 
    end 
end 
local function stopDrag(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
        isDragging = false 
        frame.ZIndex = 1 
        shadow.ZIndex = 0 
    end 
end 
