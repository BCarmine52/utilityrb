-- =========================================================================

-- Lógica para filtrar e adicionar partes
local function RetainPart(Part)
    if Part:IsA("BasePart") and not Part.Anchored and Part:IsDescendantOf(workspace) then
     
    -- Ignora partes do próprio personagem
        if Part.Parent == player.Character or Part:IsDescendantOf(player.Character) then
            return false
        end
        Part.CanCollide = false
        return true
    end
    return false
end

local function addPart(part)
    if RetainPart(part) then
     
    if not table.find(parts, part) then
            table.insert(parts, part)
        end
    end
end

local function removePart(part)
    local index = table.find(parts, part)
    if index then
        table.remove(parts, index)
    end
end

-- Preenche a lista inicial e conecta eventos
for _, part in pairs(workspace:GetDescendants()) do
    addPart(part)
end

workspace.DescendantAdded:Connect(addPart)
workspace.DescendantRemoving:Connect(removePart)

-- Loop principal do Super Ring
RunService.Heartbeat:Connect(function()
    if not ringPartsEnabled or not rootPart or not character:IsDescendantOf(workspace) then return end
   
    local tornadoCenter = rootPart.Position
    
    
    for i = #parts, 1, -1 do 
        local part = parts[i]
        
        if part and part.Parent and not part.Anchored and part:IsDescendantOf(workspace) then
            
            local pos = part.Position
          
            -- Calcula distância horizontal do centro e o ângulo
            local distFromCenter = Vector3.new(pos.X, tornadoCenter.Y, pos.Z) - tornadoCenter
            local distance = distFromCenter.Magnitude
            local angle = math.atan2(pos.Z - tornadoCenter.Z, pos.X - tornadoCenter.X)
            
            
            -- Aplica a rotação
            local newAngle = angle + math.rad(rotationSpeed)
            
            -- Calcula a posição alvo (em círculo e com altura de "funil")
            local targetPos = Vector3.new(
                tornadoCenter.X + math.cos(newAngle) * math.min(ringRadius, distance),
         
                tornadoCenter.Y + (ringHeight * (math.abs(math.sin((pos.Y - tornadoCenter.Y) / ringHeight)))),
                tornadoCenter.Z + math.sin(newAngle) * math.min(ringRadius, distance)
            )
            
            -- Define a velocidade com a força constante (rápida)
            local directionToTarget = (targetPos - part.Position)
            part.Velocity = directionToTarget.unit * attractionStrength

       
        else
            table.remove(parts, i) 
        end
    end
end)

