local function executeToggleNoclip(btnNoclip)
    noclipEnabled = not noclipEnabled

    if noclipEnabled then
      
        btnNoclip.Text = "Noclip: [On]"
        btnNoclip.BackgroundColor3 = COLOR_ON 
        notify("Noclip Ativado!",Color3.fromRGB(50,200,50))
     
        -- Garante que CanCollide = false ao ligar (reforço)
        if character then
            for _, part in character:GetDescendants() do
                if part:IsA("BasePart") then part.CanCollide = false end
     
            end
        end

    else
        
        btnNoclip.Text = "Noclip: [Off]"
        btnNoclip.BackgroundColor3 = COLOR_OFF 
        notify("Noclip Desativado!",Color3.fromRGB(200,50,50))
        
        -- CORREÇÃO: FORÇA A RESTAURAÇÃO DA COLISÃO se Fly NÃO estiver ativo
        if character and not flyEnabled then
  
            for _, part in character:GetDescendants() do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
        
    end
    
    local targetColor = noclipEnabled and COLOR_ON or COLOR_OFF
    TweenService:Create(btnNoclip, TWEEN_INFO, {BackgroundColor3 = targetColor}):Play() 
end

