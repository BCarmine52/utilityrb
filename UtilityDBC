local function updateCharacter(char)
    character = char
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    
    if humanoid then
        -- Restaurar a WalkSpeed e JumpPower salvas
        humanoid.WalkSpeed = walkSpeed
        humanoid.JumpPower = jumpPower
        
        -- Garante que o God Mode continue ativo após o renascimento
        if godModeEnabled then
            humanoid.Health = humanoid.MaxHealth
            -- Reconecta o loop do God Mode
            if not godModeLoop then
                godModeLoop = RunService.Stepped:Connect(function()
                    if humanoid and humanoid.Parent and godModeEnabled then
                        if humanoid.Health < humanoid.MaxHealth then
                            humanoid.Health = humanoid.MaxHealth
                        end
                    end
                end)
            end
        end
    end
    
    -- #########################################################################
    -- FORÇAR DESATIVAÇÃO DO FLY APÓS MORTE
    -- #########################################################################
    
    if flyEnabled then
        
        -- Desativa o Fly
        if current_connection then
            current_connection:Disconnect()
            current_connection = nil
        end
        
        if bodyVelocity and bodyVelocity.Parent then bodyVelocity:Destroy() end
        if bodyGyro and bodyGyro.Parent then bodyGyro:Destroy() end
        bodyVelocity = nil
        bodyGyro = nil
        
        isFlying = false
        
        CONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
        lCONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
        SPEED = 0

        -- Restaura o Humanoid
        humanoid.PlatformStand = false 
        rootPart.Anchored = false
        humanoid.WalkSpeed = walkSpeed 
        humanoid.JumpPower = jumpPower
        
        -- MUITO IMPORTANTE: Define o estado como desativado
        flyEnabled = false 
  
       
        -- Atualiza a GUI se o botão existir
        if guiFlyButton then
            guiFlyButton.Text = "Fly: [Off]"
            TweenService:Create(guiFlyButton, TWEEN_INFO, {BackgroundColor3 = COLOR_OFF}):Play() 
        end
        
        notify("Fly desativado devido ao renascimento.", COLOR_OFF)
    end
    
 
    -- #########################################################################
    -- FORÇAR DESATIVAÇÃO DO FLING (TOUCH/SELF) APÓS MORTE (Adicionado)
    -- #########################################################################
    if flingEnabled then
        -- Limpa os estados de Humanoid desativados pelo Fling
        if humanoid then
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.FallingDown, true)
            pcall(humanoid.SetStateEnabled, humanoid, Enum.HumanoidStateType.GettingUp, true)
        end
        
        flingEnabled = false 
        
        -- Atualiza a GUI
        local btnFling = frame:FindFirstChild("btnFling") -- Busca o botão se necessário
        if btnFling then
            btnFling.Text = "Fling (Touch): [Off]"
            TweenService:Create(btnFling, TWEEN_INFO, {BackgroundColor3 = COLOR_OFF}):Play() 
        end
        
        notify("Fling desativado devido ao renascimento.", COLOR_OFF)
    end
end

