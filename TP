local function TeleportToSpawn(character)
    task.spawn(function() 
        local HRP = character:WaitForChild("HumanoidRootPart", 5) 

        if isSetSpawnActive and savedSpawnCFrame and HRP then
            task.wait(0.1) 
            HRP.CFrame = savedSpawnCFrame + Vector3.new(0, 3, 0)
            showNotify("Teleportado para o Spawn Salvo.")
        end
    end)
end

local CharacterAddedConexao = LocalPlayer.CharacterAdded:Connect(TeleportToSpawn)
table.insert(Connections, CharacterAddedConexao)

local function CopiarPosicao()
    local Character = LocalPlayer.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if HRP then
        local pos = HRP.CFrame.p
        local roundedPos = string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
        
        if ReplicatedStorage:FindFirstChild("ClipboardFunction") then
            ReplicatedStorage.ClipboardFunction:InvokeClient(LocalPlayer, roundedPos)
        else
            setclipboard(roundedPos)
        end
        
        showNotify("Posição Copiada!") 
    else
        showNotify("ERRO: Personagem não encontrado para copiar posição.")
    end
end

local function AtivarSalvarSpawn(Botao)
    isSetSpawnActive = not isSetSpawnActive
    
    if isSetSpawnActive then
        local Character = LocalPlayer.Character
        local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
        
        if HRP then
            savedSpawnCFrame = HRP.CFrame
            Botao.BackgroundColor3 = COR_BOTAO_ON 
            Botao.Text = "Set Spawn [ON]"
            showNotify("Spawn salvo e ativo!")
        else
            isSetSpawnActive = false
            Botao.BackgroundColor3 = COR_BOTAO_OFF 
            Botao.Text = "Set Spawn [OFF]"
            showNotify("ERRO: Personagem não encontrado.")
        end
        
    else
        savedSpawnCFrame = nil
        Botao.BackgroundColor3 = COR_BOTAO_OFF 
        Botao.Text = "Set Spawn [OFF]"
        showNotify("Set Spawn desativado.")
    end
end

local function TeleportarParaPosicao(TextBox)
    local Character = LocalPlayer.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not HRP then
        showNotify("ERRO: Personagem não encontrado.")
        return
    end

    local text = TextBox.Text:gsub("%s", "")
    local parts = {}
    
    for part in text:gmatch("([^,]+)") do
        table.insert(parts, tonumber(part))
    end

    if #parts == 3 and parts[1] and parts[2] and parts[3] then
        local newPos = Vector3.new(parts[1], parts[2] + 2, parts[3]) 
        HRP.CFrame = CFrame.new(newPos)
        showNotify("Teleportado para X:" .. parts[1] .. " Y:" .. parts[2] .. " Z:" .. parts[3])
        TextBox.Text = "" 
    else
        showNotify("ERRO: Formato inválido. Use X, Y, Z.")
    end
end


