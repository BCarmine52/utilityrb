local function TeleportToPlayer(targetPlayer)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            local targetPos = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
            HRP.CFrame = targetPos
            showNotify("TP para: " .. targetPlayer.Name)
        else
            showNotify("Seu personagem não está pronto!")
        end
    else
        showNotify("Alvo não encontrado ou morto!")
    end
end

local function CreatePlayerList(ScrollingFrame)
    for _, child in pairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("UIStroke") then 
            child:Destroy()
        end
    end
    
    local players = Players:GetPlayers()
    local yOffset = 0
    local buttonHeight = 30 
    local padding = 5
    
    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            local PlayerButton = Instance.new("TextButton")
            PlayerButton.Name = "Player_" .. player.Name
            PlayerButton.Size = UDim2.new(1, -padding*2, 0, buttonHeight) 
            PlayerButton.Position = UDim2.new(0, padding, 0, yOffset + padding) 
            PlayerButton.BackgroundColor3 = COR_FUNDO_SECUNDARIO 
            PlayerButton.Text = player.Name
            PlayerButton.TextColor3 = COR_TEXTO_PADRAO
            PlayerButton.Font = Enum.Font.SourceSansSemibold 
            PlayerButton.TextSize = 16
            PlayerButton.TextXAlignment = Enum.TextXAlignment.Left 
            PlayerButton.TextYAlignment = Enum.TextYAlignment.Center 
            PlayerButton.Parent = ScrollingFrame

            local PlayerButtonCorner = Instance.new("UICorner")
            PlayerButtonCorner.CornerRadius = UDim.new(0, 8)
            PlayerButtonCorner.Parent = PlayerButton
            local PlayerButtonStroke = Instance.new("UIStroke")
            PlayerButtonStroke.Color = COR_BORDA
            PlayerButtonStroke.Transparency = 0.7 
            PlayerButtonStroke.Thickness = 1
            PlayerButtonStroke.Parent = PlayerButton

            PlayerButton.MouseEnter:Connect(function() PlayerButton.BackgroundColor3 = COR_BOTAO_HOVER end)
            PlayerButton.MouseLeave:Connect(function() PlayerButton.BackgroundColor3 = COR_FUNDO_SECUNDARIO end)
            
            PlayerButton.MouseButton1Click:Connect(function()
                TeleportToPlayer(player)
            end)
            
            yOffset = yOffset + buttonHeight + padding 
        end
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset + padding) 
end


