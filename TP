local function onDragStart(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        
        if input.Target == LabelTitulo or input.Target == BotaoMinimizar or input.Target == BotaoFechar then
            isDragging = true
            
            local mousePos = UserInputService:GetMouseLocation()
            local framePos = FramePrincipal.AbsolutePosition
            
            dragStartOffset = mousePos - framePos
            
            if not dragConnection then
                dragConnection = UserInputService.InputChanged:Connect(function(inputObject)
                    if isDragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch) then
                        
                        local newMousePos = UserInputService:GetMouseLocation()
                        local newAbsolutePos = newMousePos - dragStartOffset
                        
                        local newX = newAbsolutePos.X
                        local newY = newAbsolutePos.Y

                        FramePrincipal.Position = UDim2.new(0, newX, 0, newY) -- Posicionamento absoluto (0, newY)
                        
                        local ShadowFrame = PlayerGui.InterfacePrincipal:FindFirstChild("ShadowFrame")
                        if ShadowFrame then
                             ShadowFrame.Position = UDim2.new(0, newX - 2, 0, newY + 2) -- Shadow deve seguir a nova posição
                        end
                        
                        updateSubFramePositions(newX, newY)
                    end
                end)
                table.insert(Connections, dragConnection) 
            end
        end
    end
end

local function onDragEnd(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end

local DragStartConnection1 = LabelTitulo.InputBegan:Connect(onDragStart)
local DragStartConnection2 = BotaoMinimizar.InputBegan:Connect(onDragStart)
local DragStartConnection3 = BotaoFechar.InputBegan:Connect(onDragStart)
local DragEndConnection = UserInputService.InputEnded:Connect(onDragEnd)
table.insert(Connections, DragStartConnection1)
table.insert(Connections, DragStartConnection2)
table.insert(Connections, DragStartConnection3)
table.insert(Connections, DragEndConnection)
