-- === 2. LÓGICA DE FUNÇÕES (MANTIDO INALTERADO) ===

local function ShowNotification(text, duration, color)
    NotificationLabel.Text = text
    NotificationLabel.TextColor3 = color or TEXT_COLOR_DARK
    NotificationLabel.BackgroundTransparency = 0.8
    NotificationLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255) 
    NotificationLabel.Visible = true

    task.delay(duration or 3, function()
        if NotificationLabel and NotificationLabel.Visible then
            NotificationLabel.Visible = false
        end
    end)
end

-- SALVA A POSIÇÃO
local function SaveCurrentPosition()
    local Character = LocalPlayer.Character
    if Character and Character:FindFirstChild("HumanoidRootPart") then
        local HRP = Character.HumanoidRootPart
        
        local wasNil = (SavedCFrame == nil)
        
        SavedCFrame = HRP.CFrame 
        
        SetSpawnButton.Text = SavedButtonText
        SetSpawnButton.BackgroundColor3 = SavedButtonColor
        SetSpawnButton.TextColor3 = TEXT_COLOR_LIGHT
        
        task.delay(FeedbackDuration, function()
            if SetSpawnButton and SetSpawnButton.Text == SavedButtonText then
                SetSpawnButton.Text = DefaultButtonText
                SetSpawnButton.BackgroundColor3 = DefaultButtonColor
                SetSpawnButton.TextColor3 = TEXT_COLOR_DARK
            end
        end)
        
        if wasNil then
            isTeleportActive = true
            ToggleButton.Text = TeleportOnText
            ToggleButton.BackgroundColor3 = TeleportOnColor
            ToggleButton.TextColor3 = TEXT_COLOR_LIGHT
            ShowNotification("Point Saved! Teleport ON.", 3, ACCENT_COLOR_ON)
        end
    else
        warn("Personagem não encontrado.")
    end
end

-- TELEPORTA PARA A POSIÇÃO SALVA
local function TeleportToSavedPosition(Character)
    if isTeleportActive and SavedCFrame then
        local HRP = Character:WaitForChild("HumanoidRootPart", 5) 
        if HRP then
            local TeleportCFrame = SavedCFrame + Vector3.new(0, 1, 0) 
            pcall(function()
                HRP.CFrame = TeleportCFrame
            end)
        end
    end
end

local function ToggleTeleport()
    if not isTeleportActive and SavedCFrame == nil then
        ShowNotification("Error: Save a point first!", 3, ACCENT_COLOR_OFF)
        return
    end
    
    isTeleportActive = not isTeleportActive
    
    if isTeleportActive then
        ToggleButton.Text = TeleportOnText
        ToggleButton.BackgroundColor3 = TeleportOnColor
        ToggleButton.TextColor3 = TEXT_COLOR_LIGHT
        ShowNotification("Teleport Activated!", 2, ACCENT_COLOR_ON)
    else
        ToggleButton.Text = TeleportOffText
        ToggleButton.BackgroundColor3 = TeleportOffColor
        ToggleButton.TextColor3 = TEXT_COLOR_LIGHT
        ShowNotification("Teleport Deactivated.", 2, ACCENT_COLOR_OFF)
    end
end

-- FUNÇÃO QUE LIMPA TUDO E DESTROI O SCRIPT
local function CloseAndDestroyScript()
    isAntiAFKActive = false 
    SavedCFrame = nil 
    isTeleportActive = false
    
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    CurrentScript:Destroy()
    print("Script, HUD, e estados de spawn/teleporte resetados e destruídos.")
end

-- Função para garantir que a GUI fique na frente após o respawn
local function EnsureGUIPriority()
    if ScreenGui and PlayerGui then
        ScreenGui.Parent = nil
        task.wait(0.05) 
        ScreenGui.Parent = PlayerGui
    end
end

-- FUNÇÃO DE ANTI-AFK 
local function StartAntiAFK()
    while isAntiAFKActive do
        task.wait(20) 
        
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        
        if Character and Humanoid and Humanoid.Health > 0 then
            VirtualUser:SendInput({
                {
                    KeyCode = Enum.KeyCode.Space,
                    UserInputType = Enum.UserInputType.Keyboard,
                    State = Enum.UserInputState.Begin
                },
                {
                    KeyCode = Enum.KeyCode.Space,
                    UserInputType = Enum.UserInputType.Keyboard,
                    State = Enum.UserInputState.End
                }
            })
        end
    end
end


-- *** FUNÇÃO ARRASTÁVEL (APENAS PC/MOUSE) ***
-- Esta função agora move o 'frameToMove' (MainFrame) quando o clique é detectado no 'frameClickTarget' (TitleLabel).
local function MakeDraggable(frameToMove, frameClickTarget)
    local drag = false
    local dragStart = nil
    
    local function onInputBegan(input, gameProcessed)
        -- Verifica se é o clique do mouse (Botão 1) E se o clique ocorreu no TitleLabel
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed then
            drag = true
            dragStart = UserInputService:GetMouseLocation()
            
            -- Captura o fim do clique
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    drag = false
                end
            end)
        end
    end

    local function onInputChanged(input)
        -- Move o frame principal quando o arraste está ativo e o mouse se move
        if drag and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UserInputService:GetMouseLocation()
            local delta = mousePos - dragStart
            
            -- Atualiza a posição do MainFrame
            frameToMove.Position = UDim2.new(
                0, frameToMove.Position.Offset.X + delta.X, 
                0, frameToMove.Position.Offset.Y + delta.Y
            )
            
            dragStart = mousePos
        end
    end
    
    -- Conecta os eventos de input ao TitleLabel
    frameClickTarget.InputBegan:Connect(onInputBegan)
    frameClickTarget.InputChanged:Connect(onInputChanged)
end

-- APLICA: Arrastar o MainFrame, clicando no TitleLabel
MakeDraggable(MainFrame, TitleLabel)


