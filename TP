local function ReverterEEncerrar()

    isSetSpawnActive = false 

    for _, connection in pairs(Connections) do
        if connection and typeof(connection) == "RBXScriptConnection" then
            connection:Disconnect()
        end
    end
    Connections = {} 
    
    if dragConnection then
        dragConnection:Disconnect()
        dragConnection = nil
    end
    
    local InterfacePrincipal = PlayerGui:FindFirstChild("InterfacePrincipal")
    if InterfacePrincipal and InterfacePrincipal.Parent then
        InterfacePrincipal:Destroy()
    end
end

local function updateSubFramePositions(mainX, mainY)
    
    if not FramePrincipal then return end
    
    local mainXOffset = mainX or FramePrincipal.Position.X.Offset
    local mainYOffset = mainY or FramePrincipal.Position.Y.Offset
    local mainYScale = FramePrincipal.Position.Y.Scale
    
    local currentXOffset = mainXOffset + LARGURA_FRAME + ESPACO_ENTRE_FRAMES
    
    for _, getFrame in ipairs(SUB_FRAMES_ORDEM) do
        local frame = getFrame()
        
        if frame and frame.Parent then
            
            frame.Position = UDim2.new(0, currentXOffset, mainYScale, mainYOffset)
            
            currentXOffset = currentXOffset + LARGURA_SUBFRAME + ESPACO_ENTRE_FRAMES
        end
    end
end

local function AlternarMinimizar(Botao, Frame)
    
    isMinimized = not isMinimized

    local targetSizeMain = isMinimized and UDim2.new(0, LARGURA_FRAME, 0, ALTURA_MINIMIZADA) or UDim2.new(0, LARGURA_FRAME, 0, ALTURA_MAXIMIZADA)
    local targetText = isMinimized and "+" or "-"
    local ShadowFrame = PlayerGui.InterfacePrincipal:FindFirstChild("ShadowFrame")
    
    local targetSizePos = isMinimized and UDim2.new(0, LARGURA_SUBFRAME, 0, ALTURA_MINIMIZADA) or UDim2.new(0, LARGURA_SUBFRAME, 0, ALTURA_SUBFRAME_POS)
    local targetSizeGoTo = isMinimized and UDim2.new(0, LARGURA_SUBFRAME, 0, ALTURA_MINIMIZADA) or UDim2.new(0, LARGURA_SUBFRAME, 0, ALTURA_MAXIMIZADA)
    local isVisible = not isMinimized

    Frame.Size = targetSizeMain
    Botao.Text = targetText
    
    for _, child in pairs(Frame:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "BotaoFechar" and child.Name ~= "BotaoMinimizar" and child.Name ~= "LabelTitulo" and child.Name ~= "NotifyLabel" then
            child.Visible = isVisible
        end
    end
    if NotifyLabel then NotifyLabel.Visible = isVisible and not isMinimized end 

    if ShadowFrame then
        local targetShadowH = isMinimized and ALTURA_MINIMIZADA + 4 or ALTURA_MAXIMIZADA + 4
        ShadowFrame.Size = UDim2.new(0, LARGURA_FRAME + 4, 0, targetShadowH)
    end
    
    if PositionsFrame then
        PositionsFrame.Size = targetSizePos
        
        for _, child in pairs(PositionsFrame:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "LabelTituloPos" then
                child.Visible = isVisible
            end
        end
    end
    
    if GoToFrame then
         GoToFrame.Size = targetSizeGoTo
         
         for _, child in pairs(GoToFrame:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "LabelTituloGoTo" then
                child.Visible = isVisible
            end
        end
        
        local playerList = GoToFrame:FindFirstChild("PlayerList")
        if playerList and playerList:IsA("ScrollingFrame") then
            playerList.Visible = isVisible
        end
    end
    
    updateSubFramePositions()
end

local function showNotify(message)
    if not NotifyLabel then return end
    
    NotifyLabel.BackgroundTransparency = 1 
    NotifyLabel.TextTransparency = 1 
    
    NotifyLabel.Text = message
    NotifyLabel.Visible = true
    
    task.spawn(function()
        for i = 1, 10 do
            NotifyLabel.BackgroundTransparency = 0.9 - (i * 0.09) 
            NotifyLabel.TextTransparency = 1 - (i * 0.1) 
            task.wait(0.02)
        end
        
        task.wait(NOTIFY_DURACAO)
        
        for i = 1, 10 do
            NotifyLabel.BackgroundTransparency = 0 + (i * 0.09) 
            NotifyLabel.TextTransparency = 0 + (i * 0.1) 
            task.wait(0.02)
        end
        
        NotifyLabel.Visible = false
        NotifyLabel.BackgroundTransparency = 1
        NotifyLabel.TextTransparency = 1
    end)
end

