    TeleportToSavedPosition(Character)
    EnsureGUIPriority()
    
    -- Atualiza o estado visual do Toggle após o respawn
    if isTeleportActive then
        ToggleButton.Text = TeleportOnText
        ToggleButton.BackgroundColor3 = TeleportOnColor
        ToggleButton.TextColor3 = TEXT_COLOR_LIGHT
    else
        ToggleButton.Text = TeleportOffText
        ToggleButton.BackgroundColor3 = TeleportOffColor
        ToggleButton.TextColor3 = TEXT_COLOR_LIGHT
    end
    
    -- Garante que o Set Spawn volte para a cor original (não salva) se for o caso
    if SavedCFrame == nil then
        SetSpawnButton.Text = DefaultButtonText
        SetSpawnButton.BackgroundColor3 = DefaultButtonColor
        SetSpawnButton.TextColor3 = TEXT_COLOR_DARK
    else
        -- Se o ponto está salvo, o botão deve manter a cor de feedback (verde)
        SetSpawnButton.Text = SavedButtonText
        SetSpawnButton.BackgroundColor3 = SavedButtonColor
        SetSpawnButton.TextColor3 = TEXT_COLOR_LIGHT
        
        task.delay(FeedbackDuration, function()
            if SetSpawnButton.Text == SavedButtonText then
                SetSpawnButton.Text = DefaultButtonText
                SetSpawnButton.BackgroundColor3 = DefaultButtonColor
                SetSpawnButton.TextColor3 = TEXT_COLOR_DARK
            end
        end)
    end
end)
